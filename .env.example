# Copy to a private .env (chmod 600). Literal KEY=value; no shell expansion.
# Required: replace with the new VPS public IPv4 or IPv6 address.
PUBLIC_IP=
REALITY_PORT=8881
HYSTERIA2_PORT=8882
SS_PORT=8892
# Optional: alidns for encrypted bootstrap of node hostnames from mainland China.
MIHOMO_NODE_DNS=default

# Leave DOMAIN empty for IP-only installation. PREFIX is unique per VPS.
# Example: vps2-fast.example.org, vps2-edge.example.org, vps2-sub.example.org
DOMAIN=
PREFIX=vps2
# File containing only the Cloudflare management API token.
CF_API_TOKEN_FILE=/root/singforge/cloudflare.token
ENABLE_TUNNEL=false

# HTTPS publication uses TCP 443 and Certbot DNS-01.
ENABLE_SUBSCRIPTION=false
CERTBOT_CREDENTIALS_FILE=/root/singforge/certbot.ini
ACME_EMAIL=
ACME_AGREE_TOS=false
